{
  "name": "dormslide",
  "private": true,
  "version": "0.1.0",
  "description": "DoRmSlide 도름슬라이드 · 다 함께 만드는 오직 선생님들을 위한 슬라이드 프로젝트",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:mark && vite build",
    "build:html": "npm run check:mark && vite build --mode html && node scripts/finish-html.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run check:mark && npm run typecheck && node scripts/check-release.mjs && node scripts/build-catalog.mjs --check",
    "check:mark": "node scripts/check-mark.mjs",
    "catalog": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "subset-font": "2.9.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3"
  }
}
